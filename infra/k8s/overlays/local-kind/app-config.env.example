# Porta HTTP exposta pela API dentro do pod.
API_PORT=3000
# Porta HTTP exposta pela Function dentro do pod.
FUNCTION_APP_PORT=7071
# Ambiente do laboratorio local.
APP_RUNTIME=development
# Prefixo planejado para as rotas HTTP da API.
API_PREFIX=api
# Origem frontend liberada no laboratorio local.
API_CORS_ORIGIN=http://localhost:5173
# Namespace do canal WebSocket.
API_WS_NAMESPACE=processing
# Host do PostgreSQL dentro do cluster.
POSTGRES_HOST=postgres
# Porta do PostgreSQL dentro do cluster.
POSTGRES_PORT=5432
# Banco utilizado pelo MVP.
POSTGRES_DB=image_pipeline
# Nome do container de entrada do storage.
AZURE_STORAGE_CONTAINER_ORIGINALS=images-original
# Nome do container de saida do storage.
AZURE_STORAGE_CONTAINER_PROCESSED=images-processed
# URL interna da API para a Function abrir o WebSocket.
FUNCTION_WEBSOCKET_URL=ws://api:3000/processing
